---
import SkillTag from './SkillTag.astro';
---

<section class="bg-gray-50 dark:[background-color:rgb(3,6,32)] relative not-prose scroll-mt-[72px]">
  <div class="absolute inset-0 pointer-events-none -z-[1]" aria-hidden="true"><div class="absolute inset-0"></div></div>
  <div
    class="relative mx-auto max-w-7xl px-4 md:px-6 py-12 md:py-16 lg:py-20 text-default intersect-once intersect-quarter intersect-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
  >
    <div class="max-w-6xl mx-auto px-4">
      <div class="mb-8 md:mx-auto md:mb-12 text-center max-w-3xl">
        <h2 class="text-4xl font-bold text-center">Skills</h2>
        <p class="mt-4 text-muted text-xl">
          Explore the skills that empower me to transform ideas into functional and visually engaging web experiences.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Backend & Databases -->
        <div class="bg-white rounded-xl shadow-xl p-6 dark:bg-gray-800 ">
          <h3 class="text-xl font-semibold text-blue-600 mb-4 dark:text-white">Backend & Databases</h3>
          <div class="flex flex-wrap gap-3">
            <span class="skill-tag">Python</span>
            <span class="skill-tag">Django</span>
            <span class="skill-tag">Django REST Framework</span>
            <span class="skill-tag">Flask</span>
            <span class="skill-tag">MySQL</span>
          </div>
        </div>

        <!-- Frontend -->
        <div class="bg-white rounded-xl shadow-xl p-6 dark:bg-slate-800">
          <h3 class="text-xl font-semibold text-blue-600 mb-4 dark:text-white">Frontend</h3>
          <div class="flex flex-wrap gap-3">
            <span class="skill-tag">JavaScript</span>
            <span class="skill-tag">CSS</span>
            <span class="skill-tag">HTML</span>
          </div>
        </div>

        <!-- DevOps & Tools -->
        <div class="bg-white rounded-xl shadow-xl p-6 dark:bg-slate-800">
          <h3 class="text-xl font-semibold text-blue-600 mb-4 dark:text-white">DevOps & Tools</h3>
          <div class="flex flex-wrap gap-3">
            <span class="skill-tag">Docker</span>
            <span class="skill-tag">Git</span>
          </div>
        </div>

        <!-- CMS & PHP Development -->
        <div class="bg-white rounded-xl shadow-xl p-6 dark:bg-slate-800">
          <h3 class="text-xl font-semibold text-blue-600 mb-4 dark:text-white">CMS & PHP Development</h3>
          <div class="flex flex-wrap gap-3">
            <span class="skill-tag">WordPress</span>
            <span class="skill-tag">Elementor</span>
            <span class="skill-tag">ACF</span>
            <span class="skill-tag">WooCommerce</span>
            <span class="skill-tag">PHP</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .skill-tag {
    @apply bg-gray-100 text-black text-sm px-4 py-2 rounded-full cursor-default dark:bg-gray-700 dark:text-white hover:bg-gray-200 dark:hover:bg-gray-600 transition;
  }
</style>
