---
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
// import CallToAction from '~/components/widgets/CallToAction.astro';
import Features3 from '~/components/widgets/Features3.astro';
// import Testimonials from '~/components/widgets/Testimonials.astro';
import Steps from '~/components/widgets/Steps.astro';
// import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import { getPermalink } from '~/utils/permalinks';
import photo from '~/assets/images/20240927_211839.jpg';
import Features2 from '~/components/widgets/Features2.astro';
import Footer from '~/components/widgets/Footer.astro';
const metadata = {
  title: 'Amit Singh - Django Developer',
};
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>
  <Fragment slot="header">
    <Header
      links={[
        { text: 'Home', href: '#' },
        { text: 'About', href: '#about' },
        { text: 'Work Experience', href: '#work_experience' },
        { text: 'Skills', href: '#skills' },
        { text: 'Contact', href: '#contact' },
      ]}
      actions={[
        {
          text: 'Hire me',
          href: '#',
        },
      ]}
      isSticky
      showToggleTheme
    />
  </Fragment>

  <!-- Hero2 Widget ******************* -->

  <Hero
    id="hero"
    title="Amit Singh"
    tagline="Django Developer"
    actions={[{ variant: 'primary', text: 'Hire me', href: getPermalink('/contact#form') }]}
  >
    <Fragment slot="subtitle">
      I’m a Django Developer passionate about building efficient, scalable web applications.
With hands-on experience in Python, Django REST Framework, and modern web technologies, I turn ideas into functional, high-performance digital products. I love writing clean, maintainable code and transforming complex problems into elegant backend solutions.
    </Fragment>
  </Hero>

  <!-- Content Widget **************** -->

  <Content
    id="about"
    
    image={{
      // src: 'https://images.unsplash.com/photo-1491349174775-aaafddd81942?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80',
      src: photo,
      alt: 'Amit Singh Portrait Image',
      loading: 'eager',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">About me</h2>
      <p>
        Hi, I’m Amit Singh — a full-stack web developer and fitness entrepreneur based in Mohali, Punjab.
      </p>
      <br />
      <p>
        I currently work as a Software Developer (Python) at CS Soft Solutions Pvt. Ltd., where I build and maintain scalable web applications using Django, Django REST Framework, and modern front-end technologies..
      </p>
      <br />
      <p>With hands-on experience in backend development, API design, database optimization, and CMS customization, I love creating solutions that are both powerful and efficient</p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    id="work_experience"
    title="Work experience"
    items={[
      {
        title:
          'Django Developer <br /> <span class="font-normal">CS Soft Solutions Pvt Ltd, Mohali, PB</span> <br /> <span class="text-sm font-normal">Jan 2023 - Present</span>',
        description: `Developed scalable applications using Django and Django REST
Framework (DRF). <br /> Built REST APIs and integrated third-party services for web/mobile apps. <br /> Optimized SQL queries & ORM operations, improving response times by
~30%. <br /> Collaborated with cross-functional teams to deliver new features on
schedule.`,
        icon: 'tabler:briefcase',
      },
      {
        title:
          'Trainee <br /> <span class="font-normal">CS Soft Solutions Pvt Ltd, Mohali, PB</span> <br /> <span class="text-sm font-normal">Jan 2022 - Dec 2022</span>',
        description: `Assisted in building PHP-based applications and custom WordPress
themes/plugins.<br />Worked with WooCommerce, Elementor, ACF to deliver client solutions. <br /> Supported debugging, troubleshooting, and performance improvements`,
        icon: 'tabler:briefcase',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  />

  <!-- Steps Widget ****************** -->

  <Steps
    id="education"
    title="Education"
    items={[
      {
        title: `Bachelor of Computer Applications <br /> <span class="font-normal">Lovely Professional University, Jalandhar</span> <br /> <span class="text-sm font-normal">2023 - 2026</span>`,
        icon: 'tabler:school',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    id="skills"
    title="Skills"
    subtitle="Discover the proficiencies that allow me to bring imagination to life through design."
    columns={3}
    defaultIcon="tabler:point-filled"
    items={[
      {
        title: 'Graphic design',
        description: 'Proficient in crafting visually appealing designs that convey messages effectively.',
      },
      {
        title: 'Branding and identity',
        description: 'Skilled at developing cohesive brand identities, including logos and brand guidelines.',
      },
      {
        title: 'User-centered design',
        description: 'Experienced in creating user-friendly interfaces and optimizing user experiences.',
      },
      {
        title: 'Adobe Creative Suite',
        description: 'Skilled in using Photoshop, Illustrator, and InDesign to create and edit visual elements.',
      },
      {
        title: 'Typography',
        description: 'Adept in selecting and manipulating typefaces to enhance design aesthetics.',
      },
      {
        title: 'Color theory',
        description: 'Proficient in using color to evoke emotions and enhance visual harmony.',
      },
      {
        title: 'Print and digital design',
        description: 'Knowledgeable in designing for both print materials and digital platforms.',
      },
      {
        title: 'Attention to detail',
        description: 'Diligent in maintaining precision and quality in all design work.',
      },
      {
        title: 'Adaptability',
        description: 'Quick to adapt to new design trends, technologies, and client preferences.',
      },
    ]}
  />


  <!-- CallToAction Widget *********** -->

  <!-- <CallToAction
    title="Let's create together"
    subtitle="Ready to transform your vision into captivating designs?"
    actions={[
      {
        variant: 'primary',
        text: 'Hire me',
        href: '/',
      },
    ]}
  /> -->
  <Features2
  id="contact"
  title="Get in Touch"
  items={[
    {
      title: 'Phone',
      icon: 'tabler:headset',
      callToAction:{
      href: 'tel:+919988805966',
      text: '+91 998-880-5966',
      target: '_blank',
      variant: 'link',
      }
    },
    {
      title: 'Email',
      icon: 'tabler:mail',
      callToAction:{
      href: 'mailto:amitsingh100996@gmail.com',
      text: 'amitsingh100996@gmail.com',
      target: '_blank',
      variant: 'link',
      }
    },
    {
      title: 'LinkedIn',
      icon: 'tabler:brand-linkedin',
      callToAction:{
        href: 'https://www.linkedin.com/in/amit-singh-649808352/',
        text: 'Connect on LinkedIn',
        target: '_blank',
        variant: 'link',
      }
    },
  ]}
/>
<Fragment slot="footer">
  <Footer
    footNote=
    `© ${new Date().getFullYear()} Amit Singh. All rights reserved.`
    socialLinks={[
    // { ariaLabel: 'LinkedIn', icon: 'tabler:brand-linkedin', href: '#' },
    // { ariaLabel: 'Github', icon: 'tabler:brand-github', href: 'https://github.com/amit140507' },
    // { ariaLabel: 'Whatsapp', icon: 'tabler:brand-whatsapp', href: 'https://wa.me/919988805966' },
    { text: 'Home', href: '#' },
    { text: 'About', href: '#about' },
    { text: 'Work Experience', href: '#work_experience' },
    { text: 'Skills', href: '#skills' },
    { text: 'Contact', href: '#contact' },
  ]}
  />
</Fragment>
</Layout>
