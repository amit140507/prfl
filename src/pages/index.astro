---
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
// import CallToAction from '~/components/widgets/CallToAction.astro';
import Features3 from '~/components/widgets/Features3.astro';
// import Testimonials from '~/components/widgets/Testimonials.astro';
import Steps from '~/components/widgets/Steps.astro';
// import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import { getPermalink } from '~/utils/permalinks';
import photo from '~/assets/images/20240927_211839.png';
import resume from '~/assets/resume/Amit_Singh.pdf';
import Features2 from '~/components/widgets/Features2.astro';
import Footer from '~/components/widgets/Footer.astro';
import TechnicalSkills from '~/components/widgets/TechnicalSkills.astro';
const metadata = {
  title: 'Amit Singh - Django Developer',
};
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>
  <Fragment slot="header">
    <Header
      links={[
        { text: 'Home', href: '#' },
        { text: 'About', href: '#about' },
        { text: 'Work Experience', href: '#work_experience' },
        { text: 'Skills', href: '#skills' },
        { text: 'Contact', href: '#contact' },
      ]}
      actions={[
        {
          text: 'Download Resume',
          href: resume,
        },
      ]}
      isSticky
      showToggleTheme
    />
  </Fragment>
  <!-- Hero2 Widget ******************* -->

  <Hero
    id="hero"
    title="Amit Singh"
    tagline="Django Developer"
    actions={[{ variant: 'primary', text: 'Hire me', href: getPermalink('/contact#form') }]}
  >
    <Fragment slot="subtitle">
      <!-- Experienced Python developer specializing in Django and REST APIs. Passionate about building scalable web applications and optimizing performance. -->
      Python/Django developer focused on building robust REST APIs, integrating third‑party services, and optimizing data access. I enjoy shipping pragmatic solutions with Django, DRF, and MySQL, and collaborating across teams to deliver features on schedule.
    </Fragment>
  </Hero>

  <!-- Content Widget **************** -->

  <Content
    id="about"
    
    image={{
      // src: 'https://images.unsplash.com/photo-1491349174775-aaafddd81942?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80',
      src: photo,
      alt: 'Amit Singh Portrait Image',
      loading: 'eager',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">About me</h2>
      <p>
        Hi, I’m Amit Singh — a full-stack web developer based in Mohali, Punjab.
      </p>
      <br />
      <p>
        I currently work as a Software Developer (Python) at CS Soft Solutions Pvt. Ltd., where I build and maintain scalable web applications using Django, Django REST Framework, and modern front-end technologies.
      </p>
      <br />
      <p>With hands-on experience in backend development, API design, database optimization, and CMS customization, I love creating solutions that are both powerful and efficient</p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    id="work_experience"
    title="Work experience"
    items={[
      {
        title:
          'Django Developer <br /> <span class="font-normal">CS Soft Solutions Pvt Ltd, Mohali, PB</span> <br /> <span class="text-sm font-normal">Jan 2023 - Present</span>',
        description: `<span class="flex items-center justify-start"><svg  class="text-blue-500" xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="none"  stroke="currentColor"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-right"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9 6l6 6l-6 6" /></svg>Developed scalable applications using Django and Django REST Framework (DRF).</span>
        <span class="flex items-center justify-start"><svg  class="text-blue-500" xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="none"  stroke="currentColor"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-right"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9 6l6 6l-6 6" /></svg> Built REST APIs and integrated third-party services for web/mobile apps.</span>
        <span class="flex items-center justify-start"><svg  class="text-blue-500" xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="none"  stroke="currentColor"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-right"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9 6l6 6l-6 6" /></svg>Optimized SQL queries & ORM operations, improving response times by ~30%.</span>
        <span class="flex items-center justify-start"><svg  class="text-blue-500" xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="none"  stroke="currentColor"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-right"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9 6l6 6l-6 6" /></svg>Collaborated with cross-functional teams to deliver new features on schedule.</span>`,
        icon: 'tabler:briefcase',
      },
      {
        title:
          'Trainee <br /> <span class="font-normal">CS Soft Solutions Pvt Ltd, Mohali, PB</span> <br /> <span class="text-sm font-normal">Jan 2022 - Dec 2022</span>',
        description: `<span class="flex items-center justify-start"><svg  class="text-blue-500" xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="none"  stroke="currentColor"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-right"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9 6l6 6l-6 6" /></svg>Assisted in building PHP-based applications and custom WordPress themes/plugins.</span>
<span class="flex items-center justify-start"><svg  class="text-blue-500" xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="none"  stroke="currentColor"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-right"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9 6l6 6l-6 6" /></svg>Worked with WooCommerce, Elementor, ACF to deliver client solutions.</span>
<span class="flex items-center justify-start"><svg  class="text-blue-500" xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="none"  stroke="currentColor"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-right"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9 6l6 6l-6 6" /></svg>Supported debugging, troubleshooting, and performance improvements.</span>`,
        icon: 'tabler:briefcase',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  />

  <!-- Steps Widget ****************** -->

  <Steps
    id="education"
    title="Education"
    items={[
      {
        title: `Bachelor of Computer Applications <br /> <span class="font-normal">Lovely Professional University, Jalandhar</span> <br /> <span class="text-sm font-normal"></span>`,
        icon: 'tabler:school',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  />

  <!-- Features3 Widget ************** -->
<TechnicalSkills/>
