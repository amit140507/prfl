    id="skills"
    title="Skills"
    subtitle="Discover the proficiencies that allow me to bring imagination to life through design."
    columns={2}
    defaultIcon="tabler:chevron-right"
    items={[
      {
        title: 'Backend & Databases',
        description: 'Python, Django, Django REST Framework (DRF), MySQL',
      },
      {
        title: 'Frontend & Web Design',
        description: 'JavaScript, HTML, CSS, User-centered design',
      },
      {
